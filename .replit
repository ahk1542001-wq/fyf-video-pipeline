modules = ["python-3.11", "nodejs-20"]
run = "bash run_replit.sh"

[nix]
channel = "stable-24_05"

[deployment]
build = "cd frontend && npm ci --no-audit --no-fund && npm run build && mkdir -p .next/standalone/.next && cp -R .next/static .next/standalone/.next/ && { [ ! -d public ] || cp -R public .next/standalone/; }"
run = "FYF_PUBLIC_DEPLOYMENT=true bash run_replit.sh"
deploymentTarget = "cloudrun"

[[ports]]
localPort = 3001
externalPort = 80
