# Vertex AI Express mode (recommended for the local FYF Video Pipeline)
# Never commit the real value. Copy this file to .env and replace the placeholder.
FYF_VERTEX_API_KEY=replace-with-your-vertex-api-key
# Text retries stay on the primary Flash route by default. Set these only
# after a measured model review; never put credentials in this file.
# FYF_VERTEX_STORY_FALLBACK_MODEL=
# FYF_VERTEX_VISUAL_VERIFY_FALLBACK_MODEL=

# Gemini 3.7 Flash thinking policy. Supported values: LOW, MEDIUM, HIGH.
# Defaults are stage-specific: fact/coverage/visual verification/final QA use
# HIGH; narration/story/lock/storyboard use MEDIUM; relationship classification
# uses LOW. Override only after checking latency, thought tokens, and cost in
# the in-app telemetry view. Gemini 3.7 Flash does not support MINIMAL.
# FYF_VERTEX_THINKING_SCRIPT=
# FYF_VERTEX_THINKING_STORY=
# FYF_VERTEX_THINKING_FACT=
# FYF_VERTEX_THINKING_FACT_COVERAGE=
# FYF_VERTEX_THINKING_LOCK=
# FYF_VERTEX_THINKING_STORYBOARD=
# FYF_VERTEX_THINKING_TREATMENT=
# FYF_VERTEX_THINKING_RELATIONSHIP=
# FYF_VERTEX_THINKING_MOTION_REPAIR=
# FYF_VERTEX_THINKING_VISUAL_VERIFY=
# FYF_VERTEX_THINKING_FINAL_QA=
# FYF_VERTEX_THINKING_FINAL_REPAIR=
# FYF_VERTEX_CALL_TIMEOUT_SECONDS=
# FYF_VERTEX_RETRY_BASE_SECONDS=
# FYF_VERTEX_RETRY_MAX_SECONDS=
# FYF_SCRIPT_RETRY_BASE_SECONDS=
# FYF_SCRIPT_RETRY_MAX_SECONDS=
# Quota/deadline job retries wait longer to let the provider window recover.
# FYF_SCRIPT_QUOTA_RETRY_BASE_SECONDS=
# FYF_SCRIPT_QUOTA_RETRY_MAX_SECONDS=
# Four persisted retries is the bounded default; set lower for a strict budget.
# FYF_SCRIPT_MAX_RETRIES=
# FYF_SCRIPT_LOCK_BATCH_SIZE=

# Public-host safety controls. Keep values only in the host secret store.
# FYF_PUBLIC_DEPLOYMENT=
# FYF_PUBLIC_GENERATION_ENABLED=
# FYF_GENERATION_ACCESS_TOKEN=
# FYF_DAILY_BUDGET_CAP_USD=
# FYF_TOTAL_BUDGET_CAP_USD=
# FYF_RATE_LIMIT_PER_MINUTE=
# FYF_MAX_CONCURRENT_JOBS=

# ADC alternative:
# GOOGLE_CLOUD_PROJECT=
# FYF_VERTEX_MEDIA_LOCATION=

# Optional pricing override for a reviewed internal catalog. Unknown models
# remain unpriced by default; never put credentials in this value.
# FYF_VERTEX_PRICING_JSON=
